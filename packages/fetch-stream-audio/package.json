{
  "name": "@puresignal/fetch-stream-audio",
  "version": "0.2.1",
  "description": "Low-latency streaming audio playback using Fetch, Streams, and Web Audio APIs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "repository": "https://github.com/puresignaldev/fetch-stream-audio",
  "homepage": "https://github.com/puresignaldev/fetch-stream-audio/tree/master/packages/fetch-stream-audio#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./worker-decoder-opus": "./dist/worker-decoder-opus.js",
    "./worker-decoder-wav": "./dist/worker-decoder-wav.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.workers.config.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "opus-stream-decoder": "^1.2.6"
  },
  "devDependencies": {
    "vite-plugin-static-copy": "3.3.0"
  }
}
